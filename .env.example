# Supabase Public API Configuration (Client-Safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Admin Secret Key (Server-Only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Settings
NEXT_PUBLIC_DEFAULT_CITY=Ankleshwar
NEXT_PUBLIC_DEFAULT_STATE=Gujarat
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payment Gateway (Server-Only)
RAZORPAY_KEY_ID=rzp_test_sample_key
RAZORPAY_KEY_SECRET=rzp_test_sample_secret
